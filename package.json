{
  "name": "diego-volpatto-website",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "sciastro check",
    "test": "node --test tests/*.test.mjs",
    "check:content": "sciastro check",
    "verify": "pnpm check && pnpm build && pnpm test && pnpm security:build",
    "format": "prettier --write build scripts tests .github security-policy.yaml package.json astro.config.mjs playwright.config.mjs",
    "test:browser": "playwright test",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "security:build": "node scripts/inspect-build.mjs",
    "test:security-browser": "playwright test security.spec.mjs behavior-security.spec.mjs",
    "security": "pnpm security:build && pnpm audit:dependencies && pnpm test:security-browser",
    "verify:all": "pnpm verify && pnpm audit:dependencies && pnpm test:browser"
  },
  "dependencies": {
    "astro": "7.3.3",
    "sciastro": "1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "css-tree": "^3.2.1",
    "htmlparser2": "12.0.0",
    "parse-srcset": "^1.0.2",
    "prettier": "^3.9.8",
    "yaml": "^2.9.1"
  }
}
