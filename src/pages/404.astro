---
import { content } from "../content";
const message = content.site.notFound;
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{message.title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={base + "favicon.svg"} />
    <style>
      body {
        margin: 0;
        font:
          18px/1.6 system-ui,
          sans-serif;
        color: #171b39;
        background: #fafbfe;
        display: grid;
        min-height: 100vh;
        place-items: center;
      }
      main {
        padding: 30px;
        max-width: 600px;
      }
      span {
        color: #5146cc;
      }
      h1 {
        font:
          48px/1.1 Georgia,
          serif;
      }
      a {
        color: #5146cc;
      }
    </style>
  </head>
  <body>
    <main>
      <span>404</span>
      <h1>{message.heading}</h1>
      <p>{message.description.pt}</p>
      <p lang="en">{message.description.en}</p>
      <a href={base}>{message.homeLabel}</a>
    </main>
  </body>
</html>
