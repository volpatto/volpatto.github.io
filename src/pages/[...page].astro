---
import AcademicLayout from "../layouts/AcademicLayout.astro";
import Research from "../components/pages/Research.astro";
import Publications from "../components/pages/Publications.astro";
import Software from "../components/pages/Software.astro";
import Teaching from "../components/pages/Teaching.astro";
import Supervision from "../components/pages/Supervision.astro";
import Groups from "../components/pages/Groups.astro";
import Collaborations from "../components/pages/Collaborations.astro";
import Curriculum from "../components/pages/Curriculum.astro";
import Contact from "../components/pages/Contact.astro";
import Licensing from "../components/pages/Licensing.astro";
import { sitePages, type PageId } from "../lib/navigation";
import type { Language } from "../content";

export function getStaticPaths() {
  return sitePages
    .filter((page) => page.id !== "home")
    .flatMap((page) =>
      (["pt", "en"] as const).map((lang) => ({
        params: { page: page.path[lang].replace(/\/$/, "") },
        props: { page: page.id, lang },
      })),
    );
}
interface Props {
  page: PageId;
  lang: Language;
}
const { page, lang } = Astro.props;
const components = {
  research: Research,
  publications: Publications,
  software: Software,
  teaching: Teaching,
  people: Supervision,
  groups: Groups,
  collaborations: Collaborations,
  cv: Curriculum,
  contact: Contact,
  licensing: Licensing,
};
const Page = components[page as keyof typeof components];
---

<AcademicLayout lang={lang} page={page}>
  <Page lang={lang} />
</AcademicLayout>
