---
import Arrow from './Arrow.astro';
import { t, type Language } from '../data/profile';
import { publications } from '../data/academic';
interface Props { publication: (typeof publications)[number]; lang: Language; }
const { publication: p, lang } = Astro.props;
---
<article class="publication">
  <span class="publication-year">{p.year}</span>
  <div><p class="publication-topic">{t(p.topic, lang)}</p><h2><a href={'https://doi.org/' + p.doi}>{p.title}</a></h2><p class="authors">{p.authors}</p><p class="journal"><em>{p.journal}</em><span> · {p.citation}</span></p></div>
  <a class="doi-link" href={'https://doi.org/' + p.doi} aria-label={'DOI: ' + p.title}>DOI <Arrow diagonal /></a>
</article>
