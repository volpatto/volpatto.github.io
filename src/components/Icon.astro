---
import { brandIcons } from '../data/brand-icons';

// Simple geometric interface icons; brand artwork retains its upstream license.
const outlines = {
  user: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2',
  flask: 'M9 3h6M10 3v7L4.5 19a1.3 1.3 0 0 0 1.1 2h12.8a1.3 1.3 0 0 0 1.1-2L14 10V3M7.5 15h9',
  book: 'M12 5v16M12 5C9 3 5 3 2 4v15c3-1 7-1 10 2 3-3 7-3 10-2V4c-3-1-7-1-10 1Z',
  code: 'm8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18',
  teaching: 'M3 3h18v13H3ZM8 21l4-5 4 5M7 7h10M7 11h6',
  users: 'M11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM2 21v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2M16 5a3 3 0 0 1 0 6m1 3a5 5 0 0 1 5 5v2',
  network: 'M9 2h6v6H9ZM2 16h6v6H2Zm14 0h6v6h-6ZM12 8v4M5 16v-4h14v4',
  link: 'm9 15 6-6M8 16l-1 1a3.5 3.5 0 0 1-5-5l5-5a3.5 3.5 0 0 1 5 0m0 10a3.5 3.5 0 0 0 5 0l5-5a3.5 3.5 0 0 0-5-5l-1 1',
  file: 'M14 2H5v20h14V7l-5-5Zm0 0v6h5M8 12h8M8 16h8',
  mail: 'M3 5h18v14H3ZM3 5l9 7 9-7',
  download: 'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',
  package: 'm12 2 10 5v10l-10 5-10-5V7l10-5Zm0 10v10M2 7l10 5 10-5M7 4.5l10 5V14',
  globe: 'M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0ZM2 12h20M12 2c6 6 6 14 0 20-6-6-6-14 0-20Z',
  pin: 'M19 9c0 5-7 12-7 12S5 14 5 9a7 7 0 0 1 14 0ZM15 9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
} as const;

export type IconName = keyof typeof brandIcons | keyof typeof outlines;
interface Props { name: IconName; }
const { name } = Astro.props;
const brand = name in brandIcons ? brandIcons[name as keyof typeof brandIcons] : undefined;
---
<svg class="icon" data-icon={name} viewBox={brand?.viewBox ?? '0 0 24 24'} width="18" height="18" fill={brand ? 'currentColor' : 'none'} stroke={brand ? undefined : 'currentColor'} stroke-width={brand ? undefined : '1.65'} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {brand ? brand.paths.map(path => <path d={path} />) : <path d={outlines[name as keyof typeof outlines]} />}
</svg>
