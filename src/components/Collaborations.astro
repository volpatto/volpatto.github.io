---
import Arrow from './Arrow.astro';
import LefLogo from './LefLogo.astro';
import { t, type Language } from '../data/profile';
import { projects } from '../data/academic';
import { pageUrl } from '../data/navigation';
interface Props { lang: Language; }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<section id="collaborations" class="section" aria-labelledby="collaborations-title">
  <div class="section-heading"><h1 id="collaborations-title">{en ? 'Collaborations and projects' : 'Parcerias e projetos'}</h1><p class="section-intro">{en ? 'I collaborate with research groups at UNICAMP and UDESC on computational modeling, thermodynamics and applications in the energy sector.' : 'Colaboro com grupos da UNICAMP e da UDESC em modelagem computacional, termodinâmica e aplicações no setor de energia.'}</p></div>
  <div class="partner-list">
    <article class="partner" id="alfa">
      <div class="partner-logos"><img src={base + 'images/alfa.webp'} width="250" height="80" alt="ALFA" /><img class="institution-logo" src={base + 'images/unicamp.svg'} width="80" height="80" alt="Unicamp" /></div>
      <div class="partner-content"><p class="partner-affiliation">CEPETRO / UNICAMP</p><h2>ALFA</h2><p class="partner-fullname">Artificial Lift and Flow Assurance Research Group</p>
        <p>{en ? 'The ALFA group studies artificial lift, flow assurance and fluid flow in petroleum production systems. It brings together experimental and computational research at CEPETRO and the School of Mechanical Engineering at UNICAMP.' : 'O ALFA estuda elevação artificial, garantia de escoamento e escoamentos em sistemas de produção de petróleo. O grupo reúne pesquisa experimental e computacional no CEPETRO e na Faculdade de Engenharia Mecânica da UNICAMP.'}</p>
        <p>{en ? 'My collaboration is connected to computational modeling of production systems. I have been an invited visiting researcher at CEPETRO since 2024 and participate in the project on hybrid data and model systems for offshore well monitoring, coordinated by Marcelo Souza de Castro.' : 'Minha colaboração se relaciona à modelagem computacional de sistemas de produção. Sou pesquisador visitante convidado no CEPETRO desde 2024 e participo do projeto de sistemas híbridos de dados e modelos para monitoramento de poços offshore, coordenado por Marcelo Souza de Castro.'}</p>
        <div class="group-links"><a class="text-link" href="https://www.alfa.cepetro.unicamp.br/team/">{en ? 'Group and team' : 'Grupo e equipe'}<Arrow diagonal /></a><a class="text-link" href="https://www.alfa.cepetro.unicamp.br/research-lines/">{en ? 'Research areas' : 'Linhas de pesquisa'}<Arrow diagonal /></a></div>
      </div>
    </article>
    <article class="partner" id="lef">
      <div class="partner-logos"><LefLogo /><img class="faculty-logo" src={base + 'images/feq-unicamp.jpg'} width="380" height="153" loading="lazy" alt={en ? 'School of Chemical Engineering, Unicamp' : 'Faculdade de Engenharia Química, Unicamp'} /></div>
      <div class="partner-content"><p class="partner-affiliation">FEQ / UNICAMP</p><h2>LEF — {en ? 'Phase Equilibria Laboratory' : 'Laboratório de Equilíbrio de Fases'}</h2>
        <p>{en ? 'Led by Mariana Conceição da Costa, LEF studies phase equilibria, thermophysical properties and flash points, combining experimental measurements with thermodynamic modeling.' : 'Sob responsabilidade de Mariana Conceição da Costa, o LEF estuda equilíbrio de fases, propriedades termofísicas e pontos de fulgor, combinando medidas experimentais e modelagem termodinâmica.'}</p>
        <p>{en ? 'Since 2024, I have co-supervised graduate and undergraduate research students in collaboration with LEF. Our work includes neural-network models for biofuel flash points, with papers published in Fluid Phase Equilibria in 2025 and 2026.' : 'Desde 2024, tenho coorientado alunos de pós-graduação e iniciação científica em colaboração com o LEF. O trabalho inclui modelos de redes neurais para pontos de fulgor de biocombustíveis, com artigos publicados em Fluid Phase Equilibria em 2025 e 2026.'}</p>
        <div class="group-links"><a class="text-link" href="https://erenova.feq.unicamp.br/lef-laboratorio-de-equilibrio-de-fases/">{en ? 'Laboratory website' : 'Página do laboratório'}<Arrow diagonal /></a><a class="text-link" href="http://dgp.cnpq.br/dgp/espelhogrupo/233040">{en ? 'CNPq directory' : 'Diretório CNPq'}<Arrow diagonal /></a><a class="text-link" href="https://doi.org/10.1016/j.fluid.2026.114673">{en ? 'Joint publication (2026)' : 'Publicação conjunta (2026)'}<Arrow diagonal /></a></div>
      </div>
    </article>
    <article class="partner" id="udesc">
      <div class="partner-logos"><img src={base + 'images/thermophase.png'} width="1220" height="628" loading="lazy" alt="ThermoPhase — Fluid and Complex Systems Research Group" /></div>
      <div class="partner-content"><p class="partner-affiliation">LNCC / UDESC</p><h2>ThermoPhase</h2>
        <p>{en ? 'ThermoPhase is a multi-institutional research group based at both LNCC and UDESC. I am one of its co-leaders and have been an external collaborator at UDESC since 2023. The group brings together research in fluid thermodynamics and computational modeling, student supervision and open-source scientific software development.' : 'O ThermoPhase é um grupo de pesquisa multi-institucional, com atuação tanto no LNCC quanto na UDESC. Sou um de seus líderes e atuo como colaborador externo na UDESC desde 2023. O grupo reúne pesquisa em termodinâmica de fluidos e modelagem computacional, formação de alunos e desenvolvimento de software científico aberto.'}</p>
        <p>{en ? 'Topics include properties of CO₂-rich mixtures for CCS/CCUS and hybrid models for production and injection wells, connecting physical models, operational data and machine learning.' : 'Os temas incluem propriedades de misturas ricas em CO₂ para CCS/CCUS e modelos híbridos para poços produtores e injetores, aproximando modelos físicos, dados operacionais e aprendizado de máquina.'}</p>
        <div class="group-links"><a class="text-link" href={pageUrl('groups', lang)}>{en ? 'Research groups' : 'Grupos de pesquisa'}<Arrow /></a><a class="text-link" href={pageUrl('people', lang)}>{en ? 'Student supervision' : 'Orientações'}<Arrow /></a></div>
      </div>
    </article>
  </div>
  <section class="page-subsection" aria-labelledby="projects-title"><h2 id="projects-title">{en ? 'Research projects' : 'Projetos de pesquisa'}</h2><p class="subsection-intro">{en ? 'Projects in which I participate as a team member.' : 'Projetos de que participo como integrante da equipe.'}</p>
    <div class="projects-grid">{projects.map(p => <article class="project"><p class="project-period">{en ? 'Since ' : 'Desde '}{p.year}</p><h3>{t(p.title, lang)}</h3><p>{t(p.text, lang)}</p></article>)}</div>
    <p class="source-note">{en ? 'Periods and project status as recorded in Lattes on 23 August 2026.' : 'Períodos e situação dos projetos conforme o Lattes de 23 de agosto de 2026.'}</p>
  </section>
  <section class="page-subsection" aria-labelledby="industry-title"><h2 id="industry-title">{en ? 'Previous work in industry' : 'Atuação anterior na indústria'}</h2><p class="subsection-intro">{en ? 'My previous experience in the software industry includes scientific applications for oil and gas, covering fluid properties, digital rock analysis and geochemistry. My professional background and areas of work are described in the ' : 'Minha experiência prévia na indústria de software inclui aplicações científicas para óleo e gás, abrangendo propriedades de fluidos, rocha digital e geoquímica. A trajetória profissional e as frentes de desenvolvimento estão descritas no '}<a href={pageUrl('cv', lang)}>{en ? 'CV' : 'currículo'}</a>.</p></section>
  <section class="page-subsection" aria-labelledby="industry-partners-title">
    <h2 id="industry-partners-title">{en ? 'Industry partnerships' : 'Parcerias com a indústria'}</h2>
    <ul class="industry-partners">
      <li><a class="industry-partner-logo" href="https://www.equinor.com.br/" aria-label={en ? 'Equinor Brazil website' : 'Site da Equinor Brasil'}><img src={base + 'images/equinor.svg#red'} width="402" height="160" loading="lazy" alt="Equinor" /></a></li>
      <li><a class="industry-partner-logo" href="https://prio3.com.br/" aria-label={en ? 'PRIO website' : 'Site da PRIO'}><img src={base + 'images/prio.svg'} width="121" height="23" loading="lazy" alt="PRIO" /></a></li>
    </ul>
  </section>
</section>
