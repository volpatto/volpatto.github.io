---
// Conteúdo: conteudo/paginas/curriculo.yaml
import { content, profile, t, type Language } from "../../content";
import { pageUrl, asset, href } from "../../lib/navigation";
import Arrow from "../Arrow.astro";
import Icon from "../Icon.astro";
import RichText from "../RichText.astro";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const cv = content.cv;
---

<section id="cv" class="section cv-section" aria-labelledby="cv-title">
  <div class="cv-intro">
    <h1 id="cv-title">{t(cv.heading, lang)}</h1>
    <p>{t(cv.introduction, lang)}</p>
    <div class="cv-actions">
      <a class="text-link" href={href(profile.lattes)}>
        <Icon name="lattes" />
        {t(cv.lattesLabel, lang)}
      </a>
      <a class="text-link" href={href(profile.linkedin)}>
        <Icon name="linkedin" />
        LinkedIn
      </a>
      <a class="text-link" href={asset(cv.download.file)} download>
        <Icon name="download" />
        {t(cv.download.label, lang)}
      </a>
    </div>
    <p class="source-note">{t(cv.sourceNote, lang)}</p>
  </div>
  <section class="page-subsection" aria-labelledby="experience-title">
    <h2 id="experience-title">{t(cv.experience.heading, lang)}</h2>
    <ol class="career-timeline">
      {cv.experience.items.map((item) => (
        <li>
          <p class="career-period">{t(item.period, lang)}</p>
          <div>
            <p class="education-institution">{item.institution}</p>
            <h3>{t(item.role, lang)}</h3>
            <p>{t(item.description, lang)}</p>
            {item.activities.length > 0 && (
              <ul class="activity-list">
                {item.activities.map((activity) => (
                  <li>{t(activity, lang)}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
    <p class="related-note">
      <RichText text={cv.experience.note} lang={lang} />
    </p>
  </section>
  <section class="page-subsection" aria-labelledby="education-title">
    <h2 id="education-title">{t(cv.education.heading, lang)}</h2>
    <ol class="education-timeline">
      {cv.education.items.map((item) => (
        <li>
          <span class="education-year">{item.year}</span>
          <div>
            <p class="education-institution">{item.institution}</p>
            <h3>{t(item.degree, lang)}</h3>
            <p>{t(item.detail, lang)}</p>
            {item.thesis && (
              <>
                <p class="thesis-title">
                  {t(cv.education.thesisLabel, lang)}
                  {item.thesis}
                </p>
                <p class="thesis-advisors">
                  {t(cv.education.advisorLabel, lang)}
                  {item.advisor}. {t(cv.education.coAdvisorLabel, lang)}
                  {item.coAdvisor}.
                </p>
              </>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>
  <section class="page-subsection" aria-labelledby="appointments-title">
    <h2 id="appointments-title">{t(cv.appointments.heading, lang)}</h2>
    <dl class="appointment-list">
      {cv.appointments.items.map((item) => (
        <div>
          <dt>{item.institution}</dt>
          <dd>
            {t(item.role, lang)} · {t(item.period, lang)}
          </dd>
        </div>
      ))}
    </dl>
    <a class="text-link" href={pageUrl("collaborations", lang)}>
      {t(cv.appointments.link, lang)}
      <Arrow />
    </a>
  </section>
</section>
