---
// Conteúdo: conteudo/paginas/contato.yaml; e-mail: conteudo/site.yaml
import { content, profile, t, type Language } from "../../content";
import Icon from "../Icon.astro";
import { href } from "../../lib/navigation";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const contact = content.contact;
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="container contact-inner">
    <div>
      <h1 id="contact-title">{t(contact.heading, lang)}</h1>
      <a class="contact-email" href={"mailto:" + profile.email}>
        <Icon name="mail" />
        {profile.email}
      </a>
    </div>
    <div class="contact-address">
      <p class="contact-institution">
        <Icon name="pin" /> {t(contact.institution, lang)}
      </p>
      <address>
        {contact.address[lang].map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </address>
      <a class="text-link" href={href(contact.institutionalLink.url)}>
        <Icon name="globe" />
        {t(contact.institutionalLink.label, lang)}
      </a>
    </div>
  </div>
</section>
