---
// Conteúdo: conteudo/paginas/parcerias.yaml
import { content, t, type Language } from "../../content";
import { asset, href } from "../../lib/navigation";
import Arrow from "../Arrow.astro";
import LefLogo from "../LefLogo.astro";
import RichText from "../RichText.astro";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const collaborations = content.collaborations;
---

<section
  id="collaborations"
  class="section"
  aria-labelledby="collaborations-title"
>
  <div class="section-heading">
    <h1 id="collaborations-title">{t(collaborations.heading, lang)}</h1>
    <p class="section-intro">{t(collaborations.introduction, lang)}</p>
  </div>
  <div class="partner-list">
    {collaborations.partners.map((partner) => (
      <article class="partner" id={partner.id}>
        <div class="partner-logos">
          {partner.logos.map((logo) =>
            logo.kind === "lef" ? (
              <LefLogo />
            ) : (
              <img
                class={logo.class}
                src={asset(logo.file)}
                width={logo.width}
                height={logo.height}
                loading={logo.loading}
                alt={t(logo.alt, lang)}
              />
            ),
          )}
        </div>
        <div class="partner-content">
          <p class="partner-affiliation">{partner.affiliation}</p>
          <h2>{t(partner.name, lang)}</h2>
          {partner.fullName && (
            <p class="partner-fullname">{partner.fullName}</p>
          )}
          {partner.paragraphs.map((paragraph) => (
            <p>{t(paragraph, lang)}</p>
          ))}
          <div class="group-links">
            {partner.links.map((link) => (
              <a class="text-link" href={href(t(link.url, lang))}>
                {t(link.label, lang)}
                <Arrow diagonal={link.diagonal} />
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
  <section class="page-subsection" aria-labelledby="projects-title">
    <h2 id="projects-title">{t(collaborations.projects.heading, lang)}</h2>
    <p class="subsection-intro">
      {t(collaborations.projects.introduction, lang)}
    </p>
    <div class="projects-grid">
      {collaborations.projects.items.map((project) => (
        <article class="project">
          <p class="project-period">
            {t(collaborations.projects.sinceLabel, lang)}
            {project.year}
          </p>
          <h3>{t(project.title, lang)}</h3>
          <p>{t(project.text, lang)}</p>
        </article>
      ))}
    </div>
    <p class="source-note">{t(collaborations.projects.sourceNote, lang)}</p>
  </section>
  <section class="page-subsection" aria-labelledby="industry-title">
    <h2 id="industry-title">
      {t(collaborations.industryExperience.heading, lang)}
    </h2>
    <p class="subsection-intro">
      <RichText
        text={collaborations.industryExperience.description}
        lang={lang}
      />
    </p>
  </section>
  <section class="page-subsection" aria-labelledby="industry-partners-title">
    <h2 id="industry-partners-title">
      {t(collaborations.industryPartners.heading, lang)}
    </h2>
    <ul class="industry-partners">
      {collaborations.industryPartners.items.map((partner) => (
        <li>
          <a
            class="industry-partner-logo"
            href={href(partner.url)}
            aria-label={t(partner.label, lang)}
          >
            <img
              src={asset(partner.logo.file)}
              width={partner.logo.width}
              height={partner.logo.height}
              loading="lazy"
              alt={t(partner.logo.alt, lang)}
            />
          </a>
        </li>
      ))}
    </ul>
  </section>
</section>
