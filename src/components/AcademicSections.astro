---
import Arrow from './Arrow.astro';
import Publication from './Publication.astro';
import Collaborations from './Collaborations.astro';
import Curriculum from './Curriculum.astro';
import Licensing from './Licensing.astro';
import { profile, research, t, type Language } from '../data/profile';
import { publications, software, courses, students, alumni } from '../data/academic';
import { pageUrl, type PageId } from '../data/navigation';
interface Props { lang: Language; page: PageId; }
const { lang, page } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
{page === 'research' && (
<section id="research" class="section" aria-labelledby="research-title">
  <div class="section-heading"><h1 id="research-title">{en ? 'Research' : 'Pesquisa'}</h1></div>
  <div class="research-grid">{research.map(item => (
    <article class="research-item" id={item.id}>
      <h2>{t(item.title, lang)}</h2>
      <p>{t(item.description, lang)}</p>
      {item.detail && <p>{t(item.detail, lang)}</p>}
      {item.topics && <div class="research-topics">{item.topics.map(topic => (
        <div>
          <h3>{t(topic.title, lang)}</h3>
          <p>{t(topic.description, lang)}</p>
          <a href={topic.reference.url}>{t(topic.reference.label, lang)}</a>
        </div>
      ))}</div>}
      <figure class="research-figure">
        <a href={base + item.figure.file} aria-label={(en ? 'Enlarge figure: ' : 'Ampliar figura: ') + t(item.title, lang)}>
          <img src={base + item.figure.file} width={item.figure.width} height={item.figure.height} loading="lazy" decoding="async" alt={t(item.figure.alt, lang)} />
        </a>
        <figcaption>
          {t(item.figure.caption, lang)}
          <span class="figure-links">
            <a href={item.figure.source}>{t(item.figure.credit, lang)}</a>
            {item.figure.license && <a href={item.figure.license.url}>{item.figure.license.label}</a>}
            <a href={base + item.figure.file}>{en ? 'View full-size figure' : 'Ampliar figura'}</a>
          </span>
        </figcaption>
      </figure>
      {item.link.url !== item.figure.source && <a class="text-link" href={item.link.url}>{t(item.link.label, lang)}<Arrow diagonal /></a>}
    </article>
  ))}</div>
</section>
)}
{page === 'publications' && (
<section id="publications" class="publications-section section" aria-labelledby="publications-title">
  <div class="container">
    <div class="section-heading"><div><h1 id="publications-title">{en ? 'Publications' : 'Publicações'}</h1></div><a class="text-link" href={profile.orcid}>{en ? 'ORCID' : 'ORCID'}<Arrow diagonal /></a></div>
    <div class="publication-list">{publications.map(p => <Publication publication={p} lang={lang} />)}</div>

    <p class="source-note">{en ? 'Full academic record on ' : 'Produção acadêmica completa no '}<a href={profile.lattes}>Lattes <span aria-hidden="true">↗</span></a>.</p>
  </div>
</section>
)}
{page === 'software' && (
<section id="software" class="software-section section" aria-labelledby="software-title">
  <div class="container">
    <div class="section-heading"><div><h1 id="software-title">Software</h1></div><p class="section-intro">{en ? 'Open-source scientific software projects.' : 'Projetos de software científico com código aberto.'}</p></div>
    <div class="software-practices">
      <h2>{en ? 'Software engineering and reproducibility' : 'Engenharia de software e reprodutibilidade'}</h2>
      <p>{en ? 'I develop research software following practices used in the software industry: version control, automated testing, code quality checks and documentation. The aim is to make computational methods easier to install, verify, maintain and reuse.' : 'Desenvolvo os códigos de pesquisa seguindo práticas usadas na indústria de software: controle de versões, testes automatizados, verificações de qualidade e documentação. O objetivo é facilitar a instalação, a verificação, a manutenção e o reúso dos métodos computacionais.'}</p>
      <p>{en ? 'My previous experience in the software industry, developing scientific applications for oil and gas, contributes to this approach. My professional background is described in the ' : 'Minha experiência prévia na indústria de software, com desenvolvimento de aplicações científicas para óleo e gás, contribui para essa forma de trabalho. A trajetória profissional está descrita no '}<a href={pageUrl('cv', lang)}>{en ? 'CV' : 'currículo'}</a>.</p>
      <dl class="practice-list">
        <div><dt>{en ? 'Testing and quality' : 'Testes e qualidade'}</dt><dd>{en ? 'Automated test suites and checks in continuous integration, with validation cases appropriate to each package’s scope.' : 'Suítes de testes automatizados e verificações em integração contínua, com casos de validação adequados ao escopo de cada pacote.'}</dd></div>
        <div><dt>{en ? 'Package distribution' : 'Distribuição em pacotes'}</dt><dd>{en ? 'Installable Python packages with versioned releases and documented dependencies. Package links are provided with each project below.' : 'Pacotes Python instaláveis, com versões publicadas e dependências documentadas. Os links de distribuição estão indicados em cada projeto abaixo.'}</dd></div>
        <div><dt>{en ? 'Reproducible environments' : 'Ambientes reproduzíveis'}</dt><dd>{en ? 'Explicit dependencies, Pixi environments, examples and execution instructions to help others reproduce the computational work.' : 'Dependências explícitas, ambientes Pixi, exemplos e instruções de execução para facilitar a reprodução do trabalho computacional.'}</dd></div>
      </dl>
    </div>
    <div class="software-grid">{software.map(s => <article class="software-card"><div class="software-title">{s.logo && <div class="software-logo"><img src={base + 'images/' + s.logo.file} width={s.logo.width} height={s.logo.height} loading="lazy" alt={'Logo ' + s.name} /></div>}<h2><a href={s.repo}>{s.name}</a></h2><p class="software-meta">{t(s.category, lang)}</p></div><div class="software-description"><p>{t(s.description, lang)}</p><p>{t(s.detail, lang)}</p><div class="software-links"><a href={s.docs}>{en ? 'Documentation' : 'Documentação'}<Arrow diagonal /></a><a href={s.repo} aria-label={'GitHub: ' + s.name}>GitHub <Arrow diagonal /></a><a href={'https://pypi.org/project/' + s.name + '/'} aria-label={'PyPI: ' + s.name}>PyPI<Arrow diagonal /></a>{s.name !== 'voids' && <a href={'https://anaconda.org/conda-forge/' + s.name} aria-label={'Conda-Forge: ' + s.name}>Conda-Forge<Arrow diagonal /></a>}</div></div></article>)}</div>
    <div class="software-bottom"><p>{en ? 'Other projects: ' : 'Outros projetos: '}<a href="https://github.com/volpatto/porousdrake">porousdrake</a> {en ? 'and ' : 'e '}<a href="https://github.com/ThermoPhase-FCSRG/perphil">perphil</a>.</p><a class="text-link" href={profile.github}>{en ? 'GitHub profile' : 'Perfil no GitHub'}<Arrow /></a></div>
  </div>
</section>
)}
{page === 'teaching' && (
<section id="teaching" class="section container teaching-section" aria-labelledby="teaching-title">
  <div class="section-heading"><div><h1 id="teaching-title">{en ? 'Teaching' : 'Ensino'}</h1></div><p class="section-intro">{en ? 'Courses in the Graduate Program in Computational Modeling at LNCC.' : 'Disciplinas no Programa de Pós-Graduação em Modelagem Computacional do LNCC.'}</p></div>
  <div class="teaching-layout"><div class="course-list">{courses.map(c => <article class="course"><span class="course-code">{c.code}</span><div><h2>{t(c.title, lang)}</h2><p class="course-meta">LNCC · {en ? 'Graduate course · 36 hours · 3 credits' : 'Pós-graduação · 36 h/a · 3 créditos'}</p><p>{t(c.description, lang)}</p></div></article>)}<p class="source-note">{en ? 'Courses listed in Lattes since September 2025. Summaries follow the program’s published syllabi; current offerings are listed by LNCC.' : 'Disciplinas registradas no Lattes desde setembro de 2025. Resumos baseados nas ementas publicadas pelo programa; consulte o LNCC para a oferta do período.'}</p><a class="text-link" href="https://posgrad.lncc.br/pt-br/disciplinas-e-ementas">{en ? 'Official syllabi' : 'Ementas oficiais'}<Arrow diagonal /></a></div><aside class="teaching-material"><p class="eyebrow">{en ? 'Course material' : 'Material de curso'}</p><h2>{en ? 'An introduction to Firedrake' : 'Introdução ao Firedrake'}</h2><p>{en ? 'Computational material from the introductory course at EAMC 2022, LNCC.' : 'Material computacional do curso introdutório do EAMC 2022, no LNCC.'}</p><a class="text-link" href="https://github.com/volpatto/curso_firedrake_eamc">{en ? 'Course repository' : 'Repositório do curso'}<Arrow diagonal /></a></aside></div>
</section>
)}
{page === 'people' && (
<section id="people" class="people-section section" aria-labelledby="people-title">
  <div class="container"><div class="section-heading"><div><h1 id="people-title">{en ? 'Supervision' : 'Orientações'}</h1></div><p class="section-intro">{en ? 'Students I supervise or co-supervise at LNCC and partner institutions.' : 'Alunos que oriento ou cooriento no LNCC e em instituições parceiras.'}</p></div>
    <div class="subsection-heading"><h2>{en ? 'Current MSc students' : 'Mestrado em andamento'}</h2><span>{en ? 'Lattes · August 2026' : 'Lattes · agosto de 2026'}</span></div>
    <div class="people-grid">{students.map(s => <article class="person"><div class="person-meta"><span>{s.institution}</span><span>{en ? 'Since ' : 'Desde '}{s.year}</span></div><h3>{s.name}</h3><p class="person-role">{t(s.role, lang)}</p>{s.topic && <p class="person-topic">{t(s.topic, lang)}{s.provisional && <small>{en ? 'Provisional topic' : 'Tema provisório'}</small>}</p>}</article>)}</div>
    <details class="alumni" open><summary>{en ? 'Completed supervision' : 'Orientações concluídas'}<span class="expand-sign" aria-hidden="true">+</span></summary><div class="alumni-grid">{alumni.map(s => <article><p class="person-meta">{s.year} · {s.institution} · {s.level && t(s.level, lang)}</p><h3>{s.name}</h3><p class="person-role">{t(s.role, lang)}</p>{s.topic && <p class="person-topic">{t(s.topic, lang)}</p>}</article>)}</div></details>
  </div>
</section>
)}
{page === 'groups' && (
<section id="groups" class="section container" aria-labelledby="groups-title">
  <div class="section-heading"><div><h1 id="groups-title">{en ? 'Research groups' : 'Grupos de pesquisa'}</h1></div></div>
  <div class="groups-grid">
    <article class="group-card thermophase-card"><div class="group-identity"><img src={base + 'images/thermophase.png'} width="1220" height="628" loading="lazy" alt="ThermoPhase — Fluid and Complex Systems Research Group" /></div><div class="group-content"><div class="group-label"><span>UDESC / LNCC</span><span class="role-badge">{en ? 'Co-leader' : 'Coliderança'}</span></div><h2>ThermoPhase</h2><p>{en ? 'ThermoPhase is a multi-institutional research group based at both LNCC and UDESC. It studies thermodynamic modeling and numerical simulation of complex fluids, connecting data, machine learning and applications in energy engineering.' : 'O ThermoPhase é um grupo de pesquisa multi-institucional, com atuação tanto no LNCC quanto na UDESC. Estuda modelagem termodinâmica e simulação numérica de fluidos complexos, conectando dados, aprendizado de máquina e aplicações em engenharia de energia.'}</p><p>{en ? 'Activities include student supervision and development of tools such as torch-flash and thermoml-io, with documented computational examples and reusable Python packages.' : 'As atividades incluem orientação de alunos e desenvolvimento de ferramentas como torch-flash e thermoml-io, com exemplos computacionais documentados e pacotes Python reutilizáveis.'}</p><div class="group-links"><a class="text-link" href="https://github.com/ThermoPhase-FCSRG">GitHub<Arrow diagonal /></a><a class="text-link" href="http://dgp.cnpq.br/dgp/espelhogrupo/820839">{en ? 'CNPq directory' : 'Diretório CNPq'}<Arrow diagonal /></a></div></div></article>
    <article class="group-card ipes-card"><div class="group-identity ipes-identity"><img src={base + 'images/ipes.jpg'} width="224" height="200" loading="lazy" alt="IPES — Innovative Parallel Finite Element Solvers" /></div><div class="group-content"><div class="group-label"><span>LNCC</span><span class="role-badge">{en ? 'Member' : 'Membro'}</span></div><h2>IPES</h2><p>{en ? 'The IPES group at LNCC develops and analyzes numerical methods for multiscale problems, combining finite elements, parallel computing and scientific software. Research topics include hybrid mixed multiscale methods and flow simulation in heterogeneous media.' : 'O grupo IPES, no LNCC, desenvolve e analisa métodos numéricos para problemas multiescala, reunindo elementos finitos, computação paralela e software científico. Entre os temas estão métodos multiescala híbridos mistos e simulação de escoamentos em meios heterogêneos.'}</p><div class="group-links"><a class="text-link" href="https://ipes.lncc.br/">{en ? 'Group website' : 'Site do grupo'}<Arrow diagonal /></a></div></div></article>
  </div>
</section>
)}
{page === 'collaborations' && <Collaborations lang={lang} />}
{page === 'cv' && <Curriculum lang={lang} />}
{page === 'licensing' && <Licensing lang={lang} />}
{page === 'contact' && (
<section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="container contact-inner"><div><h1 id="contact-title">{en ? 'Contact' : 'Contato'}</h1><a class="contact-email" href={'mailto:' + profile.email}>{profile.email}<Arrow diagonal /></a></div><div class="contact-address"><p class="contact-institution">{en ? 'National Laboratory for Scientific Computing' : 'Laboratório Nacional de Computação Científica'}</p><address>{en ? 'Room 2A-12' : 'Sala 2A-12'}<br />Av. Getúlio Vargas, 333 · Quitandinha<br />Petrópolis, RJ · {en ? 'Brazil' : 'Brasil'}<br />25651-075</address><a class="text-link" href="https://www.gov.br/lncc/pt-br">{en ? 'Institutional website' : 'Site institucional'}<Arrow diagonal /></a></div></div></section>
)}
