---
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import { profile, t, type Language } from '../data/profile';
import { education } from '../data/academic';
import { experience, academicAppointments } from '../data/career';
import { pageUrl } from '../data/navigation';
interface Props { lang: Language; }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<section id="cv" class="section cv-section" aria-labelledby="cv-title">
  <div class="cv-intro">
    <h1 id="cv-title">{en ? 'Experience and education' : 'Experiência e formação'}</h1>
    <p>{en ? 'My work combines academic research, teaching and professional scientific software development. Since 2025, I have been a researcher at LNCC, following my experience in the software industry.' : 'Minha trajetória reúne pesquisa acadêmica, ensino e desenvolvimento profissional de software científico. Desde 2025, sou pesquisador do LNCC, após uma atuação na indústria de software.'}</p>
    <div class="cv-actions"><a class="text-link" href={profile.lattes}><Icon name="lattes" />{en ? 'Lattes CV' : 'Currículo Lattes'}</a><a class="text-link" href={profile.linkedin}><Icon name="linkedin" />LinkedIn</a><a class="text-link" href={base + 'files/cv-diego-volpatto-2026.pdf'} download><Icon name="download" />{en ? 'Download academic CV (PDF, Portuguese)' : 'Baixar currículo acadêmico (PDF)'}</a></div>
    <p class="source-note">{en ? 'Academic CV based on the Lattes record updated on 23 August 2026. The complete record is available on the Lattes platform.' : 'Currículo acadêmico com dados do Lattes atualizado em 23 de agosto de 2026. O registro completo está disponível na Plataforma Lattes.'}</p>
  </div>
  <section class="page-subsection" aria-labelledby="experience-title">
    <h2 id="experience-title">{en ? 'Professional experience' : 'Experiência profissional'}</h2>
    <ol class="career-timeline">{experience.map(item => <li><p class="career-period">{t(item.period, lang)}</p><div><p class="education-institution">{item.institution}</p><h3>{t(item.role, lang)}</h3><p>{t(item.description, lang)}</p>{item.activities.length > 0 && <ul class="activity-list">{item.activities.map(activity => <li>{t(activity, lang)}</li>)}</ul>}</div></li>)}</ol>
    <p class="related-note">{en ? 'This industry experience informs the testing, packaging and reproducibility practices used in my ' : 'Essa experiência na indústria orienta as práticas de testes, distribuição e reprodutibilidade dos meus projetos de '}<a href={pageUrl('software', lang)}>{en ? 'scientific software projects' : 'software científico'}</a>.</p>
  </section>
  <section class="page-subsection" aria-labelledby="education-title">
    <h2 id="education-title">{en ? 'Education' : 'Formação acadêmica'}</h2>
    <ol class="education-timeline">{education.map(item => <li><span class="education-year">{item.year}</span><div><p class="education-institution">{item.institution}</p><h3>{t(item.degree, lang)}</h3><p>{t(item.detail, lang)}</p>{'thesis' in item && <><p class="thesis-title">{en ? 'Thesis: ' : 'Título: '}{item.thesis}</p><p class="thesis-advisors">{en ? 'Supervisor: ' : 'Orientação: '}{item.advisor}. {en ? 'Co-supervisor: ' : 'Coorientação: '}{item.coAdvisor}.</p></>}</div></li>)}</ol>
  </section>
  <section class="page-subsection" aria-labelledby="appointments-title">
    <h2 id="appointments-title">{en ? 'Academic collaborations' : 'Colaborações acadêmicas'}</h2>
    <dl class="appointment-list">{academicAppointments.map(item => <div><dt>{item.institution}</dt><dd>{t(item.role, lang)} · {t(item.period, lang)}</dd></div>)}</dl>
    <a class="text-link" href={pageUrl('collaborations', lang)}>{en ? 'Collaborations and research projects' : 'Parcerias e projetos de pesquisa'}<Arrow /></a>
  </section>
</section>
