---
import { profile, type Language } from '../data/profile';
import { pageUrl } from '../data/navigation';
interface Props { lang: Language; }
const { lang } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="profile-affiliation">LNCC · {en ? 'Computational modeling' : 'Modelagem computacional'}</p>
    <h1 id="hero-title">Diego Volpatto</h1>
    <p class="hero-description">{en ? 'I am a researcher at the National Laboratory for Scientific Computing (LNCC/MCTI) and a faculty member of its Graduate Program in Computational Modeling.' : 'Sou pesquisador adjunto do Laboratório Nacional de Computação Científica (LNCC/MCTI) e docente permanente do Programa de Pós-Graduação em Modelagem Computacional.'}</p>
    <p class="hero-description">{en ? 'I work on numerical methods for porous media flow, computational thermodynamics and machine learning applied to scientific problems.' : 'Trabalho com métodos numéricos para escoamentos em meios porosos, termodinâmica computacional e aprendizado de máquina aplicado a problemas científicos.'}</p>
    <p class="hero-description">{en ? 'My previous experience in the software industry includes work as a senior developer of scientific software for oil and gas applications. In my research projects, I adopt software engineering practices such as automated testing, installable packages and documented environments to support reproducibility.' : 'Minha experiência prévia na indústria de software inclui a atuação como desenvolvedor sênior de software científico para aplicações em óleo e gás. Nos projetos de pesquisa, adoto práticas de engenharia de software como testes automatizados, pacotes instaláveis e ambientes documentados para facilitar a reprodutibilidade.'}</p>
    <div class="profile-links"><a href={profile.lattes}>Lattes</a><a href={profile.orcid}>ORCID</a><a href={profile.github}>GitHub</a><a href={profile.linkedin}>LinkedIn</a><a href={pageUrl('contact', lang)}>{en ? 'Contact' : 'Contato'}</a></div>
  </div>
  <figure class="portrait-block">
    <img src={base + 'images/diego-volpatto.jpg'} alt="Diego Volpatto" width="460" height="460" fetchpriority="high" />
    <figcaption>Petrópolis, {en ? 'Brazil' : 'Brasil'}</figcaption>
  </figure>
</section>
<section class="about-details" aria-labelledby="about-details-title">
  <h2 id="about-details-title">{en ? 'Academic background' : 'Atuação e formação'}</h2>
  <p>{en ? 'I hold a degree in Chemical Engineering from UFRN and MSc and DSc degrees in Computational Modeling from LNCC. I have been a researcher at LNCC since 2025.' : 'Sou formado em Engenharia Química pela UFRN, com mestrado e doutorado em Modelagem Computacional pelo LNCC. Atuo como pesquisador no LNCC desde 2025.'}</p>
  <p>{en ? 'I am a co-leader of ThermoPhase (UDESC/LNCC) and a member of IPES. I also collaborate with researchers at UDESC and UNICAMP.' : 'Sou um dos líderes do ThermoPhase (UDESC/LNCC) e membro do IPES. Também mantenho colaborações de pesquisa com a UDESC e a UNICAMP.'}</p>
  <p>{en ? 'My professional background and education are detailed in the ' : 'Minha trajetória profissional e formação estão detalhadas na página de '}<a href={pageUrl('cv', lang)}>{en ? 'CV' : 'currículo'}</a>{en ? ' page.' : '.'}</p>
  <p>{en ? 'My ' : 'As páginas de '}<a href={pageUrl('research', lang)}>{en ? 'research' : 'pesquisa'}</a>{en ? ', ' : ', '}<a href={pageUrl('publications', lang)}>{en ? 'publications' : 'publicações'}</a>{en ? ' and ' : ' e '}<a href={pageUrl('software', lang)}>software</a>{en ? ' pages describe my work in more detail.' : ' apresentam mais detalhes sobre meu trabalho.'}</p>
</section>
