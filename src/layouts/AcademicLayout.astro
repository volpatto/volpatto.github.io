---
import "@fontsource-variable/manrope";
import "@fontsource-variable/newsreader";
import "../styles/global.css";
import Arrow from "../components/Arrow.astro";
import LnccSymbol from "../components/LnccSymbol.astro";
import Icon from "../components/Icon.astro";
import { content, profile, t, type Language } from "../content";
import {
  pages,
  pageUrl,
  pageLabel,
  asset,
  href,
  navIcons,
  type PageId,
} from "../lib/navigation";
interface Props {
  lang: Language;
  page?: PageId;
}
const { lang, page = "home" } = Astro.props;
const en = lang === "en";
const { identity, interface: labels, footer } = content.site;
const title =
  page === "home"
    ? t(identity.homeTitle, lang)
    : `${pageLabel(page, lang)} · ${identity.shortName}`;
const description = t(content[page].page.description, lang);
const canonical = new URL(pageUrl(page, lang), Astro.site);
---

<!doctype html>
<html lang={en ? "en" : "pt-BR"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171b39" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("dv-theme");
        } catch {}
        if (theme !== "light" && theme !== "dark")
          theme = matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="pt-BR"
      href={new URL(pageUrl(page, "pt"), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(pageUrl(page, "en"), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pageUrl(page, "pt"), Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: profile.name,
        url: new URL(pageUrl("home", lang), Astro.site).toString(),
        jobTitle: t(identity.jobTitle, lang),
        worksFor: {
          "@type": "Organization",
          name: identity.organization,
          url: identity.organizationUrl,
        },
        sameAs: [
          profile.lattes,
          profile.orcid,
          profile.github,
          profile.linkedin,
        ],
      })}
    ></script>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">
      {t(labels.skipToContent, lang)}
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a
          class="brand-link"
          href={pageUrl("home", lang)}
          aria-label={t(labels.homeLabel, lang)}
        >
          <LnccSymbol />
        </a>
        <div class="site-identity">
          <a href={pageUrl("home", lang)}>{identity.shortName}</a>
          <span>{identity.affiliation}</span>
        </div>
        <div class="header-controls">
          <div class="language-switch" aria-label={t(labels.language, lang)}>
            <a
              href={pageUrl(page, "pt")}
              lang="pt-BR"
              aria-current={!en ? "page" : undefined}
              aria-label="Português"
              title="Português"
            >
              <img
                class="language-flag"
                src={asset("images/flags/br.svg")}
                alt=""
                width="20"
                height="15"
              />
              PT
            </a>
            <span aria-hidden="true">/</span>
            <a
              href={pageUrl(page, "en")}
              lang="en"
              aria-current={en ? "page" : undefined}
              aria-label="English"
              title="English"
            >
              <img
                class="language-flag"
                src={asset("images/flags/gb.svg")}
                alt=""
                width="20"
                height="15"
              />
              EN
            </a>
          </div>
          <button
            class="theme-toggle"
            type="button"
            hidden
            aria-pressed="false"
            aria-label={t(labels.darkMode, lang)}
            data-dark-label={t(labels.darkMode, lang)}
            data-light-label={t(labels.lightMode, lang)}
          >
            <svg
              class="moon-icon"
              viewBox="0 0 24 24"
              width="19"
              height="19"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.5 13.1A8.5 8.5 0 0 1 10.9 3.5a8.5 8.5 0 1 0 9.6 9.6Z" />
            </svg>
            <svg
              class="sun-icon"
              viewBox="0 0 24 24"
              width="19"
              height="19"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <div class="container site-shell">
      <aside class="site-sidebar">
        <nav id="main-nav" aria-label={t(labels.navigation, lang)}>
          <details class="navigation-disclosure" open>
            <summary class="menu-toggle">
              {labels.menu} <span aria-hidden="true">☰</span>
            </summary>
            <div class="nav-links">
              {pages.map((item) => (
                <a
                  href={pageUrl(item.id, lang)}
                  data-page={item.id}
                  aria-current={page === item.id ? "page" : undefined}
                >
                  <Icon name={navIcons[item.id]} />
                  <span>{t(item.label, lang)}</span>
                </a>
              ))}
            </div>
          </details>
        </nav>
      </aside>
      <main id="main" class="site-main">
        <slot />
      </main>
    </div>
    <footer class="container site-footer">
      <a
        class="brand-link"
        href="#main"
        aria-label={t(labels.backToTopLabel, lang)}
      >
        <LnccSymbol />
      </a>
      <p class="copyright">{footer.copyright}</p>
      <a href={href(identity.organizationUrl)}>
        {identity.affiliation} <Arrow diagonal />
      </a>
      <a class="back-to-top" href="#main">
        {t(labels.backToTop, lang)} ↑
      </a>
      <p class="footer-license">
        {t(footer.textLabel, lang)}
        <a href="https://creativecommons.org/licenses/by/4.0/">
          CC BY 4.0
        </a>. {t(footer.codeLabel, lang)}
        <a href={asset("licenses/MIT.txt")}>MIT</a>.{" "}
        {t(footer.disclaimer, lang)}
        <a
          href={pageUrl("licensing", lang)}
          aria-current={page === "licensing" ? "page" : undefined}
        >
          {t(footer.licensingLabel, lang)}
        </a>
        .
      </p>
    </footer>
    <script>
      const themeButton =
        document.querySelector<HTMLButtonElement>(".theme-toggle");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
      function applyTheme(theme: "dark" | "light") {
        document.documentElement.dataset.theme = theme;
        const dark = theme === "dark";
        if (themeButton) {
          const label =
            (dark
              ? themeButton.dataset.lightLabel
              : themeButton.dataset.darkLabel) || "";
          themeButton.setAttribute("aria-label", label);
          themeButton.setAttribute("title", label);
          themeButton.setAttribute("aria-pressed", String(dark));
        }
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", dark ? "#141827" : "#fcfcfe");
      }
      applyTheme(
        document.documentElement.dataset.theme === "dark" ? "dark" : "light",
      );
      if (themeButton) themeButton.hidden = false;
      themeButton?.addEventListener("click", () => {
        const theme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        try {
          localStorage.setItem("dv-theme", theme);
        } catch {}
        applyTheme(theme);
      });
      systemTheme.addEventListener("change", (event) => {
        let saved: string | null = null;
        try {
          saved = localStorage.getItem("dv-theme");
        } catch {}
        if (saved !== "light" && saved !== "dark")
          applyTheme(event.matches ? "dark" : "light");
      });
      window.addEventListener("storage", (event) => {
        if (event.key === "dv-theme" || event.key === null) {
          const theme = event.newValue;
          applyTheme(
            theme === "light" || theme === "dark"
              ? theme
              : systemTheme.matches
                ? "dark"
                : "light",
          );
        }
      });
      const disclosure = document.querySelector<HTMLDetailsElement>(
        ".navigation-disclosure",
      );
      const menu = document.querySelector<HTMLElement>(".menu-toggle");
      const mobileQuery = window.matchMedia("(max-width: 850px)");
      const updateMenu = () => {
        if (disclosure) disclosure.open = !mobileQuery.matches;
      };
      updateMenu();
      mobileQuery.addEventListener("change", updateMenu);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && mobileQuery.matches && disclosure?.open) {
          disclosure.open = false;
          menu?.focus();
        }
      });
      // Preserve links shared when the site was a single page.
      if (document.body.dataset.page === "home" && location.hash) {
        const oldSection = location.hash.slice(1);
        const destination = [
          ...document.querySelectorAll<HTMLAnchorElement>(".nav-links a"),
        ].find((link) => link.dataset.page === oldSection);
        if (destination) location.replace(destination.href);
      }
    </script>
  </body>
</html>
